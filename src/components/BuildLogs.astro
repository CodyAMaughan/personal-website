---
import { getCollection } from 'astro:content';

const allPosts = (await getCollection('build-logs')).sort(
	(a, b) => new Date(b.data.pubDate).valueOf() - new Date(a.data.pubDate).valueOf()
);

const featured = allPosts.filter(post => post.data.featured);
const others = allPosts.filter(post => !post.data.featured);

// Combine: Featured first, then the rest (sorted by date), max 3
const posts = [...featured, ...others].slice(0, 3);
---

<section class="max-w-4xl mx-auto px-6 py-20" id="blog">
    <h2 class="text-3xl font-bold text-white mb-12">Build Logs</h2>
    <div class="space-y-10">
        {posts.map((post) => (
            <article class="group cursor-pointer border-b border-surface-highlight pb-10 last:border-0 hover:border-surface-highlight/80 transition-colors">
                <a href={`/build-logs/${post.slug}`} class="block">
                    <div class="flex flex-col md:flex-row md:justify-between md:items-baseline mb-3 gap-2">
                        <div class="flex items-center gap-3">
                            <h3 class="text-2xl font-semibold text-white group-hover:text-primary transition-colors">
                                {post.data.title}
                            </h3>
                            {post.data.featured && (
                                <span class="px-2 py-0.5 rounded-full text-xs font-medium bg-primary/20 text-primary border border-primary/30 uppercase tracking-wider">
                                    Featured
                                </span>
                            )}
                        </div>
                        <span class="text-sm font-mono text-text-muted shrink-0">{post.data.pubDate.toLocaleDateString('en-US', { month: 'long', day: 'numeric', year: 'numeric' })}</span>
                    </div>
                    <p class="text-base text-text-muted leading-relaxed max-w-3xl group-hover:text-text transition-colors">
                        {post.data.description}
                    </p>
                    <div class="mt-4 flex items-center text-primary text-sm font-medium opacity-0 group-hover:opacity-100 transition-all duration-300 transform translate-y-2 group-hover:translate-y-0">
                        Read Entry <span class="ml-2">→</span>
                    </div>
                </a>
            </article>
        ))}
    </div>
    
    <div class="mt-12 flex justify-center">
        <a 
            href="/buildlogs" 
            class="inline-flex items-center px-6 py-3 border border-surface-highlight rounded-lg text-text hover:text-white hover:border-primary/50 transition-all duration-300 group"
        >
            View All Build Logs
            <span class="ml-2 transform group-hover:translate-x-1 transition-transform">→</span>
        </a>
    </div>
</section>
