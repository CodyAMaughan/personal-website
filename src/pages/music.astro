---
import Layout from '../layouts/Layout.astro';
import { getCollection } from 'astro:content';

const musicTracks = await getCollection('music');
const sortedTracks = musicTracks.sort((a, b) => parseInt(b.data.releaseYear) - parseInt(a.data.releaseYear));

---

<Layout title="Music Archive | Cody Maughan">
  <main class="max-w-4xl mx-auto px-4 py-20">
    <header class="mb-12">
        <h1 class="text-4xl font-bold font-heading mb-4 text-transparent bg-clip-text bg-gradient-to-r from-primary to-accent">Music Archive</h1>
        <p class="text-text-muted text-lg font-mono">A collection of sonic experiments and released tracks.</p>
    </header>

    <div class="space-y-4">
        {sortedTracks.map(track => (
            <div class="group bg-surface-elevation-low border border-surface-highlight rounded-lg p-6 hover:border-primary transition-all duration-300">
                <div class="flex flex-col md:flex-row md:items-center justify-between gap-4 mb-4">
                    <div>
                        <h2 class="text-xl font-bold text-text group-hover:text-primary transition-colors">{track.data.title}</h2>
                        <div class="flex items-center gap-4 text-sm text-text-muted mt-1 font-mono">
                            <span>{track.data.releaseYear}</span>
                            <span>•</span>
                            <span>{track.data.duration}</span>
                        </div>
                    </div>
                    
                    <a href={track.data.audioUrl} target="_blank" rel="noopener noreferrer" 
                       class="inline-flex items-center justify-center px-4 py-2 rounded bg-surface-elevation-high border border-surface-highlight text-sm font-medium hover:bg-primary hover:text-black transition-colors">
                        <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 mr-2" viewBox="0 0 20 20" fill="currentColor">
                            <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zM9.555 7.168A1 1 0 008 8v4a1 1 0 001.555.832l3-2a1 1 0 000-1.664l-3-2z" clip-rule="evenodd" />
                        </svg>
                        Listen (R2)
                    </a>
                </div>
                
                {/* Optional: Add an actual audio player if desired, though the prompt asked for R2 Strategy labeling */}
                <audio controls class="w-full mt-4 bg-transparent" preload="none">
                    <source src={track.data.audioUrl} type="audio/mpeg" />
                    Your browser does not support the audio element.
                </audio>
            </div>
        ))}

        {sortedTracks.length === 0 && (
            <div class="text-center py-12 border border-dashed border-surface-highlight rounded-lg">
                <p class="text-text-muted font-mono">No tracks found in the archive.</p>
            </div>
        )}
    </div>
  </main>
</Layout>
