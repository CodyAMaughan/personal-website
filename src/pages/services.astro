---
export const prerender = true;
import Layout from '../layouts/Layout.astro';
import { HeroBackground } from '../components/HeroBackground';
import { ProjectBackground } from '../components/ProjectBackground';
import { ContactForm } from '../components/ContactForm';
---

<Layout title="Services | Cody Maughan">
    <div class="relative w-full overflow-x-hidden">
        <!-- Hero Section -->
        <section class="min-h-[50vh] flex items-center justify-center w-full relative overflow-hidden py-20">
            <HeroBackground client:load />

            <div class="w-full max-w-4xl mx-auto px-6 z-10">
                <div class="animate-fade-in relative p-8 md:p-12 rounded-card bg-surface border border-border backdrop-blur-xl shadow-2xl">
                    <div class="text-center">
                        <h1 class="text-4xl md:text-6xl font-bold mb-6 tracking-tight text-white">
                            Custom Engineering for <span class="text-transparent bg-clip-text bg-gradient-to-r from-primary via-secondary to-accent">Creators & Experts</span>
                        </h1>
                        <p class="text-lg md:text-xl text-gray-300 leading-relaxed max-w-2xl mx-auto">
                            High-performance, custom-coded websites built from scratch. No Wix, no WordPress, no bloat—just clean, blazing-fast code with AI integrations tailored to your needs.
                        </p>
                    </div>
                </div>
            </div>

            <!-- Fade to black at bottom of hero -->
            <div class="absolute bottom-0 left-0 right-0 h-32 bg-gradient-to-t from-background to-transparent pointer-events-none"></div>
        </section>

        <main class="w-full pb-32">
            <!-- Value Props Section with ProjectBackground -->
            <section class="relative py-16">
                <ProjectBackground client:load />
                
                <div class="max-w-6xl mx-auto px-6 relative z-10">
                    <div class="grid grid-cols-1 gap-8 mb-20">
                        <div class="group flex flex-col md:flex-row items-center md:items-start gap-6 p-8 rounded-2xl bg-surface/70 border border-surface-highlight/50 backdrop-blur-md hover:border-primary/30 transition-all duration-300">
                            <div class="w-24 h-24 shrink-0 rounded-xl overflow-hidden shadow-2xl group-hover:scale-105 transition-transform duration-500">
                                <img src="/images/services/lightning-fast.png" alt="Lightning Fast" class="w-full h-full object-cover" />
                            </div>
                            <div class="text-center md:text-left">
                                <h3 class="text-2xl font-bold text-white mb-3">Lightning Fast</h3>
                                <p class="text-lg text-text-muted leading-relaxed">Sub-second load times with optimized static builds. I build with performance as a first-class citizen so your visitors never have to wait.</p>
                            </div>
                        </div>
                        <div class="group flex flex-col md:flex-row items-center md:items-start gap-6 p-8 rounded-2xl bg-surface/70 border border-surface-highlight/50 backdrop-blur-md hover:border-secondary/30 transition-all duration-300">
                            <div class="w-24 h-24 shrink-0 rounded-xl overflow-hidden shadow-2xl group-hover:scale-105 transition-transform duration-500">
                                <img src="/images/services/ai-enhanced.png" alt="AI Enhanced" class="w-full h-full object-cover" />
                            </div>
                            <div class="text-center md:text-left">
                                <h3 class="text-2xl font-bold text-white mb-3">AI-Enhanced</h3>
                                <p class="text-lg text-text-muted leading-relaxed">Integrate smart features—chatbots, content generation, and intelligent automation—directly into your web application to supercharge your workflow.</p>
                            </div>
                        </div>
                        <div class="group flex flex-col md:flex-row items-center md:items-start gap-6 p-8 rounded-2xl bg-surface/70 border border-surface-highlight/50 backdrop-blur-md hover:border-accent/30 transition-all duration-300">
                            <div class="w-24 h-24 shrink-0 rounded-xl overflow-hidden shadow-2xl group-hover:scale-105 transition-transform duration-500">
                                <img src="/images/services/built-for-you.png" alt="Built For You" class="w-full h-full object-cover" />
                            </div>
                            <div class="text-center md:text-left">
                                <h3 class="text-2xl font-bold text-white mb-3">Built for You</h3>
                                <p class="text-lg text-text-muted leading-relaxed">No generic templates or bloated page builders. Every line of code is handwritten to match your unique brand identity and business goals perfectly.</p>
                            </div>
                        </div>
                    </div>
                </div>
            </section>

            <!-- Contact Form Section -->
            <section class="relative py-16">
                <div class="max-w-2xl mx-auto px-6">
                    <div class="relative p-8 md:p-10 rounded-2xl bg-surface/90 border border-surface-highlight/50 backdrop-blur-xl shadow-2xl">
                        <div class="text-center mb-8">
                            <h2 class="text-2xl md:text-3xl font-bold text-white mb-3">Let's Build Something Great</h2>
                            <p class="text-text-muted">Tell me about your project and I'll get back to you within 24-48 hours.</p>
                        </div>
                        
                        <ContactForm client:load />
                    </div>
                </div>
            </section>
        </main>
    </div>
</Layout>

<style>
    .animate-fade-in {
        animation: fadeIn 0.8s ease-out forwards;
    }

    @keyframes fadeIn {
        from {
            opacity: 0;
            transform: translateY(20px);
        }
        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    .rounded-card {
        border-radius: 1.5rem;
    }
</style>
