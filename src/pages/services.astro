---
export const prerender = true;
import Layout from "../layouts/Layout.astro";
import { HeroBackground } from "../components/HeroBackground";

const CONSULTING_URL = "https://maughanco.com";
---

<Layout
    title="Services | Cody Maughan — Maughan Consulting"
    description="I build custom automations for businesses through Maughan Consulting: software that takes repetitive work off your team's plate, built in weeks and priced up front."
>
    <div class="relative w-full overflow-x-hidden">
        <section
            class="min-h-[70vh] flex items-center justify-center w-full relative overflow-hidden py-20"
        >
            <HeroBackground client:load />

            <div class="w-full max-w-3xl mx-auto px-6 z-10">
                <div
                    class="animate-fade-in relative p-8 md:p-12 rounded-card bg-surface border border-border backdrop-blur-xl shadow-2xl text-center space-y-6"
                >
                    <p class="text-sm md:text-base text-text-muted font-mono tracking-wider uppercase">
                        Maughan Consulting
                    </p>
                    <h1 class="text-4xl md:text-6xl font-bold tracking-tight text-white">
                        Custom <span
                            class="text-transparent bg-clip-text bg-gradient-to-r from-primary via-secondary to-accent"
                            >automations</span
                        > for your business
                    </h1>
                    <p class="text-lg md:text-xl text-gray-300 leading-relaxed max-w-2xl mx-auto">
                        My client work now lives at Maughan Consulting. I build software that
                        takes the repetitive work off your team's plate: built in weeks, priced
                        up front, and looked after once it's live.
                    </p>
                    <div class="flex flex-wrap justify-center gap-4 pt-2">
                        <a
                            href={CONSULTING_URL}
                            class="inline-flex items-center px-6 py-3 rounded-lg bg-primary text-white font-semibold hover:opacity-90 transition-opacity"
                        >
                            Visit maughanco.com &rarr;
                        </a>
                        <a
                            href={`${CONSULTING_URL}/#contact`}
                            class="inline-flex items-center px-6 py-3 rounded-lg border border-white/25 text-white hover:border-white/60 hover:bg-white/10 transition-colors font-semibold"
                        >
                            Book a free 30-minute call
                        </a>
                    </div>
                </div>
            </div>

            <div
                class="absolute bottom-0 left-0 right-0 h-32 bg-gradient-to-t from-background to-transparent pointer-events-none"
            >
            </div>
        </section>
    </div>
</Layout>
