---
export const prerender = true;
import Layout from "../../layouts/Layout.astro";
import { getCollection } from "astro:content";
import { MuxPlayer } from "../../components/MuxPlayer";

const libremotionVideos = (
  await getCollection("portfolio", ({ data }) => data.project === "libremotion")
).sort(
  (a, b) =>
    new Date(b.data.pubDate).valueOf() - new Date(a.data.pubDate).valueOf(),
);

const featuredVideos = libremotionVideos
  .filter((video) => video.data.featured)
  .slice(0, 3);
const showcaseVideo = featuredVideos[0] ?? libremotionVideos[0];
const showcaseIsVertical = showcaseVideo?.data.aspectRatio === "9:16";
const showcaseMediaWrapperClass = showcaseIsVertical
  ? "mx-auto w-full max-w-sm md:max-w-md"
  : "w-full";

const getMuxThumbnail = (playbackId?: string) => {
  if (!playbackId || playbackId.startsWith("REPLACE_")) return null;
  return `https://image.mux.com/${playbackId}/thumbnail.jpg?time=1`;
};
---

<Layout
  title="LibreMotion | Cody Maughan"
  description="LibreMotion portfolio and case studies for AI-assisted ad and short-form video production."
>
  <main class="max-w-6xl mx-auto px-6 py-20 space-y-14" data-pagefind-body>
    <section
      class="rounded-3xl border border-white/10 p-8 md:p-12 overflow-hidden relative"
    >
      <div
        class="absolute inset-0 opacity-25"
        style="background: linear-gradient(135deg, #06b6d4, #4ade80, #a855f7);"
      >
      </div>
      <div class="relative z-10 space-y-6">
        <p class="text-sm uppercase tracking-[0.25em] text-white/80 font-mono">
          LibreMotion
        </p>
        <h1 class="text-4xl md:text-6xl font-bold text-white leading-tight">
          Agentic video production for ads and social short-form
        </h1>
        <p class="text-lg text-white/90 max-w-3xl leading-relaxed">
          LibreMotion is my code-first video system built on Remotion. It
          transforms intent into scripted scenes, assembles creative variants
          quickly, and ships polished outputs for paid social and organic
          channels.
        </p>
        <div class="flex flex-wrap gap-4">
          <a
            href="/libremotion/portfolio"
            class="inline-flex items-center px-5 py-3 rounded-lg bg-white text-black font-bold hover:opacity-90 transition-opacity"
          >
            View Full Portfolio
          </a>
          <a
            href="/follow-him-scripture-shorts"
            class="inline-flex items-center px-5 py-3 rounded-lg border border-white/30 text-white font-semibold hover:bg-white/10 transition-colors"
          >
            See Follow Him Scripture Shorts
          </a>
        </div>
      </div>
    </section>

    {
      showcaseVideo && (
        <section class="space-y-4">
          <h2 class="text-2xl md:text-3xl font-bold text-white">
            Featured Video
          </h2>
          <div class="flex justify-center w-full">
            <MuxPlayer
              client:visible
              playbackId={showcaseVideo.data.muxPlaybackId || ""}
              title={showcaseVideo.data.title}
              aspectRatio={showcaseVideo.data.aspectRatio}
              className="mx-auto"
              style={{
                height: "auto",
                width: "auto",
                maxHeight: "calc(100vh - 150px)",
                maxWidth: "100%",
                aspectRatio: showcaseVideo.data.aspectRatio
                  ? showcaseVideo.data.aspectRatio.replace(":", "/")
                  : "16/9",
              }}
            />
          </div>
          {showcaseVideo.data.description && (
            <p class="text-text-muted leading-relaxed">
              {showcaseVideo.data.description}
            </p>
          )}
        </section>
      )
    }

    <section class="space-y-6">
      <div class="flex flex-wrap items-end justify-between gap-3">
        <h2 class="text-2xl md:text-3xl font-bold text-white">
          Recent LibreMotion Portfolio Items
        </h2>
        <a
          href="/libremotion/portfolio"
          class="text-primary hover:text-primary-hover font-medium"
        >
          Browse All ->
        </a>
      </div>

      {
        libremotionVideos.length === 0 ? (
          <div class="p-6 rounded-xl border border-white/10 bg-surface/40 text-text-muted">
            No portfolio videos yet. Add entries to{" "}
            <code>src/content/portfolio</code>.
          </div>
        ) : (
          <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
            {libremotionVideos.slice(0, 6).map((video) => {
              const thumbnail = getMuxThumbnail(video.data.muxPlaybackId);
              const isVertical = video.data.aspectRatio === "9:16";
              const aspectRatio = video.data.aspectRatio
                ? video.data.aspectRatio.replace(":", "/")
                : "16/9";
              return (
                <a
                  href={`/libremotion/portfolio/${video.id}`}
                  class="group rounded-2xl overflow-hidden border border-white/10 bg-surface/40 hover:border-primary/60 transition-colors flex flex-col"
                  style={{ maxHeight: "calc(100vh - 140px)" }}
                >
                  <div class="flex-1 min-h-0 w-full flex items-center justify-center bg-black/40">
                    {thumbnail ? (
                      <img
                        src={thumbnail}
                        alt={`${video.data.title} thumbnail`}
                        class="max-h-full max-w-full object-contain mx-auto"
                        style={{
                          aspectRatio: aspectRatio,
                          width: "auto",
                          height: "auto",
                        }}
                        loading="lazy"
                      />
                    ) : (
                      <div class="w-full h-full grid place-items-center text-white/80 bg-gradient-to-br from-cyan-500/30 to-purple-500/30 font-medium">
                        Mux Preview Placeholder
                      </div>
                    )}
                  </div>
                  <div class="p-4 space-y-2 flex-shrink-0">
                    <h3 class="text-white font-semibold group-hover:text-primary transition-colors">
                      {video.data.title}
                    </h3>
                    <p class="text-sm text-text-muted line-clamp-3">
                      {video.data.description || "No description provided."}
                    </p>
                  </div>
                </a>
              );
            })}
          </div>
        )
      }
    </section>
  </main>
</Layout>
