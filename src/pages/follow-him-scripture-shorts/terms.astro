---
export const prerender = true;
import Layout from "../../layouts/Layout.astro";
const updated = "November 17, 2026";
---

<Layout title="Terms of Service | Follow Him Scripture Shorts" description="Terms of service for the Follow Him Scripture Shorts publishing tool.">
  <main class="pt-20">
    <section class="max-w-3xl mx-auto px-6 py-20 text-text-muted leading-relaxed space-y-6">
