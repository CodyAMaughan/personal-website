---
export const prerender = true;
import Layout from "../layouts/Layout.astro";
import { getCollection } from "astro:content";
import { MuxPlayer } from "../components/MuxPlayer";

const videos = (
  await getCollection(
    "portfolio",
    ({ data }) => data.project === "follow-him-scripture-shorts",
  )
).sort(
  (a, b) =>
    new Date(b.data.pubDate).valueOf() - new Date(a.data.pubDate).valueOf(),
);

const featuredVideo = videos.find((video) => video.data.featured) ?? videos[0];
const featuredIsVertical = featuredVideo?.data.aspectRatio === "9:16";
const featuredMediaWrapperClass = featuredIsVertical
  ? "mx-auto w-full max-w-sm md:max-w-md"
  : "w-full";

const profileMap = new Map<string, string>();
for (const video of videos) {
  for (const profile of video.data.profiles || []) {
    profileMap.set(profile.name, profile.url);
  }
}

if (!profileMap.has("YouTube")) {
  profileMap.set(
    "YouTube",
    "https://www.youtube.com/@FollowHimScriptureShorts",
  );
}
if (!profileMap.has("X")) {
  profileMap.set("X", "https://x.com/followhimshorts");
}

const profiles = [...profileMap.entries()].map(([name, url]) => ({
  name,
  url,
}));

const getMuxThumbnail = (playbackId?: string) => {
  if (!playbackId || playbackId.startsWith("REPLACE_")) return null;
  return `https://image.mux.com/${playbackId}/thumbnail.jpg?time=1`;
};

const getYouTubeThumbnail = (youtubeId?: string) => {
  if (!youtubeId) return null;
  return `https://img.youtube.com/vi/${youtubeId}/hqdefault.jpg`;
};

const toAspectRatio = (ratio?: string) =>
  ratio === "9:16" ? "9 / 16" : "16 / 9";
---

<Layout
  title="Follow Him Scripture Shorts | Cody Maughan"
  description="Daily reverent short-form videos from Come, Follow Me passages, produced with LibreMotion and published across social channels."
>
  <main class="max-w-6xl mx-auto px-6 py-20 space-y-12" data-pagefind-body>
    <section
      class="rounded-3xl border border-white/10 p-8 md:p-12 relative overflow-hidden"
    >
      <div
        class="absolute inset-0 opacity-20 bg-gradient-to-br from-cyan-500 via-green-400 to-purple-500"
      >
      </div>
      <div class="relative z-10 space-y-6">
        <p class="text-sm uppercase tracking-[0.25em] text-white/80 font-mono">
          Follow Him Scripture Shorts
        </p>
        <h1 class="text-4xl md:text-6xl font-bold text-white leading-tight">
          Reverent daily shorts from this week's Come, Follow Me
        </h1>
        <p class="text-lg text-white/90 max-w-3xl leading-relaxed">
          This project publishes one short per day, each built around scripture
          and designed for short-form platforms. I batch-produce the weekly set
          on Sundays and schedule one video for each day of the following week.
        </p>
        <div class="flex flex-wrap gap-3">
          {
            profiles.map((profile) => (
              <a
                href={profile.url}
                target="_blank"
                rel="noopener noreferrer"
                class="inline-flex items-center px-4 py-2 rounded-lg border border-white/25 text-white hover:border-white/60 hover:bg-white/10 transition-colors"
              >
                {profile.name}
              </a>
            ))
          }
        </div>
        <div class="flex flex-wrap gap-4">
          <a
            href="/libremotion"
            class="text-white font-semibold hover:text-primary transition-colors"
          >
            Built with LibreMotion ->
          </a>
          <a
            href="/libremotion/portfolio"
            class="text-white font-semibold hover:text-primary transition-colors"
          >
            View full video portfolio ->
          </a>
        </div>
      </div>
    </section>

    {
      featuredVideo && (
        <section class="space-y-4">
          <h2 class="text-2xl md:text-3xl font-bold text-white">
            Featured Short
          </h2>
          <div class="flex justify-center w-full">
            {featuredVideo.data.muxPlaybackId ? (
              <MuxPlayer
                client:visible
                playbackId={featuredVideo.data.muxPlaybackId}
                title={featuredVideo.data.title}
                aspectRatio={featuredVideo.data.aspectRatio}
                className="mx-auto"
                style={{
                  height: "auto",
                  width: "auto",
                  maxHeight: "calc(100vh - 150px)",
                  maxWidth: "100%",
                  aspectRatio:
                    "9:16" === featuredVideo.data.aspectRatio ? "9/16" : "16/9",
                }}
              />
            ) : featuredVideo.data.youtubeId ? (
              <div
                class="overflow-hidden rounded-2xl border border-white/10 mx-auto"
                style={`aspect-ratio: ${toAspectRatio(featuredVideo.data.aspectRatio)}; max-height: calc(100vh - 150px); width: auto; height: auto;`}
              >
                <iframe
                  src={`https://www.youtube.com/embed/${featuredVideo.data.youtubeId}`}
                  title={featuredVideo.data.title}
                  allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
                  allowfullscreen
                  class="h-full w-full"
                  loading="lazy"
                />
              </div>
            ) : (
              <div class="p-6 rounded-xl border border-white/10 bg-surface/40 text-text-muted">
                No playback source is configured yet.
              </div>
            )}
          </div>
          <p class="text-text-muted">
            {featuredVideo.data.description || "No description provided."}
          </p>
        </section>
      )
    }

    <section class="space-y-5">
      <h2 class="text-2xl md:text-3xl font-bold text-white">Recent Videos</h2>

      {
        videos.length === 0 ? (
          <div class="p-6 rounded-xl border border-white/10 bg-surface/40 text-text-muted">
            No scripture short entries yet. Add portfolio items with project set
            to <code>follow-him-scripture-shorts</code>.
          </div>
        ) : (
          <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
            {videos.map((video) => {
              const thumbnail =
                getMuxThumbnail(video.data.muxPlaybackId) ||
                getYouTubeThumbnail(video.data.youtubeId);
              const aspectRatio = toAspectRatio(video.data.aspectRatio);

              return (
                <a
                  href={`/libremotion/portfolio/${video.id}`}
                  class="group rounded-2xl overflow-hidden border border-white/10 bg-surface/40 hover:border-primary/60 transition-colors flex flex-col"
                  style={{ maxHeight: "calc(100vh - 140px)" }}
                >
                  <div class="flex-1 min-h-0 w-full flex items-center justify-center bg-black/40">
                    {thumbnail ? (
                      <img
                        src={thumbnail}
                        alt={`${video.data.title} thumbnail`}
                        class="max-h-full max-w-full object-contain mx-auto"
                        style={{
                          aspectRatio: aspectRatio,
                          width: "auto",
                          height: "auto",
                        }}
                        loading="lazy"
                      />
                    ) : (
                      <div
                        class="w-full h-full grid place-items-center text-white/80 bg-gradient-to-br from-cyan-500/30 to-purple-500/30 font-medium"
                        style={`aspect-ratio: ${aspectRatio};`}
                      >
                        Video Placeholder
                      </div>
                    )}
                  </div>
                  <div class="p-4 space-y-2 flex-shrink-0">
                    <h3 class="text-white font-semibold group-hover:text-primary transition-colors">
                      {video.data.title}
                    </h3>
                    <p class="text-sm text-text-muted">
                      {video.data.description || "No description provided."}
                    </p>
                  </div>
                </a>
              );
            })}
          </div>
        )
      }
    </section>

    <section class="flex justify-center">
      <a
        href="https://www.youtube.com/@FollowHimScriptureShorts"
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center px-6 py-3 rounded-lg border border-white/25 text-white hover:border-white/60 hover:bg-white/10 transition-colors font-semibold"
      >
        Watch more on YouTube &rarr;
      </a>
    </section>

    <section class="rounded-2xl border border-white/10 p-6 bg-surface/30">
      <h2 class="text-xl font-semibold text-white mb-3">Publishing Notes</h2>
      <ul class="space-y-2 text-text-muted">
        <li>Weekly production cadence: Sundays.</li>
        <li>Publishing schedule: one short each day for the upcoming week.</li>
        <li>
          Current platforms: YouTube and X (X automation still being
          stabilized).
        </li>
      </ul>
    </section>
  </main>
</Layout>
