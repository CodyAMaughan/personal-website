---
export const prerender = true;
import Layout from "../../layouts/Layout.astro";
---

<Layout
    title="Scripture Jeopardy | Cody Maughan"
    description="A classroom Jeopardy! game for Old Testament Doctrinal Mastery — five fun categories, hints, scorekeeping, and a Daily Double."
    showBackground={false}
>
    <main class="max-w-6xl mx-auto px-4 py-20">
        <header class="mb-8 text-center">
            <h1
                class="text-4xl font-bold mb-4 text-transparent bg-clip-text bg-gradient-to-r from-primary to-accent"
            >
                Doctrinal Mastery Jeopardy!
            </h1>
            <p class="text-text-muted text-lg font-mono">
                A classroom Jeopardy! board for the 24 Old Testament Doctrinal Mastery scriptures.
            </p>
        </header>

        <div
            class="relative w-full border border-surface-highlight rounded-lg overflow-hidden bg-black"
            style="aspect-ratio: 16 / 9;"
        >
            <iframe
                id="game-frame"
                src="/games/scripture-jeopardy/game.html"
                class="w-full h-full border-0"
                allow="autoplay; fullscreen; cross-origin-isolated"
                allowfullscreen
            >
            </iframe>
        </div>

        <div class="flex justify-center gap-4 mt-4">
            <button
                id="fullscreen-btn"
                class="px-4 py-2 text-sm font-mono border border-surface-highlight rounded-lg hover:border-primary hover:text-primary transition-all cursor-pointer bg-transparent text-text-muted"
            >
                Fullscreen
            </button>
        </div>

        <section class="mt-12 border border-surface-highlight rounded-lg p-6">
            <h2 class="text-2xl font-bold mb-4 text-text">About</h2>
            <p class="text-text-muted leading-relaxed mb-4">
                A full Jeopardy! board for seminary classroom review of all 24
                Old Testament Doctrinal Mastery scriptures. Five categories
                (Emoji Salad, Tabloid Headlines, 5 Words or Less, Auto-Corrected
                Prophets, and Movie Pitches) plus a Daily Double callback.
                Each clue supports two progressive hints and a one-click reveal,
                with built-in score tracking for two teams and a rotating set of
                themed Jeopardy soundtracks.
            </p>
            <div class="flex flex-wrap gap-2">
                {
                    [
                        "HTML",
                        "JavaScript",
                        "Seminary",
                        "Quiz Game",
                        "Classroom",
                    ].map((tag) => (
                        <span class="px-3 py-1 text-xs font-mono border border-surface-highlight rounded-full text-text-muted">
                            {tag}
                        </span>
                    ))
                }
            </div>
        </section>
    </main>
</Layout>

<script>
    document.getElementById("fullscreen-btn")?.addEventListener("click", () => {
        const frame = document.getElementById(
            "game-frame"
        ) as HTMLIFrameElement;
        if (frame) {
            frame.requestFullscreen?.();
        }
    });

    document.addEventListener("keydown", (e) => {
        if (e.key === "Escape" && document.fullscreenElement) {
            document.exitFullscreen();
        }
    });
</script>
