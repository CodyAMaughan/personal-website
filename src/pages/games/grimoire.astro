---
export const prerender = true;
import "../../styles/global.css";
import "@fontsource/inter/400.css";
import "@fontsource/inter/700.css";
import GrimoireApp from "../../components/grimoire/GrimoireApp";
---

<html lang="en">
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
        <meta name="theme-color" content="#0f0f12" />
        <meta name="apple-mobile-web-app-capable" content="yes" />
        <meta name="mobile-web-app-capable" content="yes" />
        <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
        <meta name="apple-mobile-web-app-title" content="Grimoire" />
        <meta name="description" content="A phone-first Storyteller's grimoire for Blood on the Clocktower: automatic reminders, a night queue, and computed night information. Unofficial fan tool." />
        <meta name="robots" content="noindex" />
        <link rel="icon" type="image/svg+xml" href="/grimoire/icon.svg" />
        <link rel="apple-touch-icon" href="/grimoire/icon-180.png" />
        <link rel="manifest" href="/grimoire/manifest.webmanifest" />
        <title>Grimoire · Storyteller tool</title>
    </head>
    <body class="bg-[#0f0f12] font-sans antialiased">
        <GrimoireApp client:only="react" />
    </body>
</html>
