---
export const prerender = true;
import Layout from "../layouts/Layout.astro";
import Hero from "../components/Hero.astro";
import { BentoGrid } from "../components/BentoGrid";
import TechStack from "../components/TechStack.astro";
import { AuroraBackground } from "../components/AuroraBackground";
import BuildLogs from "../components/BuildLogs.astro";
import { getEntry } from "astro:content";
import { marked } from "marked";
import { getImage } from "astro:assets";
import headshotImage from "../assets/images/heroImage.jpeg";
import libreMotionLogo from "../assets/images/libre-motion-logo.png";
import procodeLogo from "../assets/images/procode-logo.png";
import ghostWriterLogo from "../assets/images/ghost-writer-logo.png";
import autographLogo from "../assets/images/autograph-logo.png";

// Fetch home page content from Keystatic
const homePage = await getEntry("home", "index");
if (!homePage) return Astro.redirect("/404");
const { data } = homePage;

// Parse markdown in subheadline to HTML (inline to avoid wrapping in <p> tags)
const subheadlineHtml = data.subheadline
    ? await marked.parseInline(data.subheadline)
    : "";

// Hero data (passing raw asset so Hero.astro can optimize)
const heroData = {
    tagline: data.tagline || "Technical Founder & Product Engineer",
    headline: data.headline || "Building the future of",
    headlineHighlight: data.headlineHighlight || "Agentic AI & SaaS.",
    subheadline: subheadlineHtml,
    heroImage: headshotImage,
};
const optimizedLogos = {
    LibreMotion: (
        await getImage({
            src: libreMotionLogo,
            width: 128,
            height: 128,
            format: "webp",
        })
    ).src,
    ProCode: (
        await getImage({
            src: procodeLogo,
            width: 128,
            height: 128,
            format: "webp",
        })
    ).src,
    "Ghost Writer": (
        await getImage({
            src: ghostWriterLogo,
            width: 128,
            height: 128,
            format: "webp",
        })
    ).src,
    Autograph: (
        await getImage({
            src: autographLogo,
            width: 138, // 46 rendered size x 3 for retina/high-res
            height: 138,
            format: "webp",
        })
    ).src,
};

// Optimize project logos for BentoGrid
---

<Layout
    title="Cody Maughan | Technical Founder & Product Engineer"
    showBackground={false}
>
    <main class="overflow-x-hidden selection:bg-primary selection:text-white">
        <!-- Hero Section -->
        <Hero {...heroData} />

        <!-- Projects Section -->
        <BentoGrid client:visible optimizedLogos={optimizedLogos} />

        <!-- Tech Stack Marquee -->
        <TechStack />

        <!-- Build Logs (Blog) -->
        <div class="relative w-full">
            <AuroraBackground client:visible />
            <BuildLogs />
        </div>
    </main>
</Layout>
