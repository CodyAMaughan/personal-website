---
import "../styles/global.css";
import "@fontsource/inter/400.css";
import "@fontsource/inter/500.css";
import "@fontsource/inter/600.css";
import "@fontsource/inter/700.css";
import "@fontsource/jetbrains-mono/400.css";
import "@fontsource/jetbrains-mono/500.css";
import { theme } from "../config/theme";
import { AuroraBackground } from "../components/AuroraBackground";
import { Navbar } from "../components/Navbar";
import SEO from "../components/SEO.astro";

interface Props {
    title: string;
    description?: string;
    image?: string;
    type?: "website" | "article";
    showBackground?: boolean;
}

const { title, description, image, type, showBackground = true } = Astro.props;

// Inject theme colors as CSS variables
const cssVariables = Object.entries(theme.colors)
    .map(([key, value]) => {
        const kebabKey = key.replace(/[A-Z]/g, (m) => "-" + m.toLowerCase());
        return `--color-${kebabKey}: ${value};`;
    })
    .join(" ");
---

<!doctype html>
<html lang="en">
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width" />
        <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
        <meta name="generator" content={Astro.generator} />

        <SEO {title} {description} {image} {type} />
    </head>
    <body
        style={cssVariables}
        class="relative min-h-screen text-text bg-background selection:bg-primary selection:text-black"
    >
        {showBackground && <AuroraBackground client:idle />}

        <Navbar client:load />

        <slot />

        <footer
            class="py-10 text-center text-text-muted text-sm border-t border-surface-highlight mt-20"
        >
            <div
                class="max-w-4xl mx-auto px-4 flex flex-col md:flex-row justify-between items-center gap-4"
            >
                <p>
                    &copy; {new Date().getFullYear()} Cody Maughan. All rights reserved.
                </p>
                <div class="flex gap-6">
                    <a
                        href="https://github.com/CodyAMaughan"
                        target="_blank"
                        class="hover:text-primary transition-colors">GitHub</a
                    >
                    <a
                        href="https://www.linkedin.com/in/cody-maughan-1817739b/"
                        target="_blank"
                        class="hover:text-primary transition-colors">LinkedIn</a
                    >
                </div>
            </div>
        </footer>
    </body>
</html>
